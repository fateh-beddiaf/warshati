{
  "name": "warshati",
  "productName": "Warshati",
  "version": "1.0.0",
  "private": true,
  "description": "Offline desktop app for running a phone repair shop: repair tickets, barcode labels, debts and profit sharing.",
  "author": "Fateh Beddiaf",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/fateh-beddiaf/warshati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fateh-beddiaf/warshati.git"
  },
  "bugs": "https://github.com/fateh-beddiaf/warshati/issues",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/build-license-txt.cjs && electron-vite build && electron-builder --win --x64 --publish never",
    "preview": "electron-vite preview",
    "test": "node scripts/run-tests.cjs",
    "test:e2e": "electron-vite build && playwright test",
    "test:packaged": "playwright test -c playwright.packaged.config.ts",
    "screenshots": "electron-vite build && playwright test -c playwright.screenshots.config.ts",
    "icons": "electron scripts/build-icons.cjs",
    "check:ui": "node scripts/check-ui.cjs --rtl",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.tests.json",
    "postinstall": "node scripts/install-native.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run check:ui && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "jsbarcode": "^3.12.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/fuses": "^1.8.0",
    "@eslint-react/eslint-plugin": "^5.24.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-direction": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "framer-motion": "^12.4.7",
    "globals": "^17.13.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.2",
    "prettier": "^3.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.1.0",
    "zxing-wasm": "^3.1.4"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
